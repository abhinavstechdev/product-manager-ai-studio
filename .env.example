# GEMINI_API_KEY: Optional for built-in Gemini Assistant test console
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet or Vercel deployment is hosted
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (e.g. Neon, Supabase, or self-hosted PostgreSQL).
# If not provided, the platform automatically boots an in-memory/embedded transactional store for zero-config testing.
DATABASE_URL="postgres://username:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AUTH_SECRET: 32+ character secret used to sign session cookies and OAuth 2.1 JWT tokens
AUTH_SECRET="nexus_super_secret_jwt_and_session_key_32chars_min"

# MCP_SERVER_URL: Public or internal URL pointing to the /api/mcp endpoint
MCP_SERVER_URL="http://localhost:3000/api/mcp"

